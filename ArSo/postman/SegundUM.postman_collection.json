{
  "info": {
    "name": "SegundUM",
    "description": "Pruebas de la aplicacion SegundUM desplegada con Docker Compose (pasarela en puerto 9000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login correcto', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('token', body.token);",
                  "pm.environment.set('userId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Alta usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario creado', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const location = pm.response.headers.get('Location');",
                  "if (location) {",
                  "    const parts = location.split('/');",
                  "    pm.environment.set('userId', parts[parts.length - 1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Garcia Lopez\",\n  \"email\": \"{{email}}\",\n  \"clave\": \"{{password}}\",\n  \"fechaNacimiento\": \"1995-06-15\",\n  \"telefono\": \"600111222\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/usuarios/{{userId}}"
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/usuarios"
          }
        }
      ]
    },
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar categorias raiz",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Categorias disponibles', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const categorias = pm.response.json();",
                  "if (Array.isArray(categorias) && categorias.length > 0) {",
                  "    pm.environment.set('categoryId', categorias[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categorias"
          }
        },
        {
          "name": "Alta producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producto creado', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const location = pm.response.headers.get('Location');",
                  "if (location) {",
                  "    const parts = location.split('/');",
                  "    pm.environment.set('productId', parts[parts.length - 1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Portatil de prueba\",\n  \"descripcion\": \"Portatil para pruebas Postman\",\n  \"precio\": 499.99,\n  \"estado\": \"NUEVO\",\n  \"idCategoria\": \"{{categoryId}}\",\n  \"envioDisponible\": true,\n  \"idVendedor\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "Obtener producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/productos/{{productId}}"
          }
        },
        {
          "name": "Buscar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "productos"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Compraventas",
      "item": [
        {
          "name": "Registrar compraventa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProducto\": \"{{productId}}\",\n  \"idComprador\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/compraventas"
          }
        },
        {
          "name": "Compras del usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/compraventas/comprador/{{userId}}"
          }
        },
        {
          "name": "Ventas del usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/compraventas/vendedor/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Flujo completo",
      "item": [
        {
          "name": "1. Alta usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario creado', function () { pm.response.to.have.status(201); });",
                  "const location = pm.response.headers.get('Location');",
                  "if (location) {",
                  "    const parts = location.split('/');",
                  "    pm.environment.set('userId', parts[parts.length - 1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellidos\": \"Garcia Lopez\",\n  \"email\": \"{{email}}\",\n  \"clave\": \"{{password}}\",\n  \"fechaNacimiento\": \"1995-06-15\",\n  \"telefono\": \"600111222\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios"
          }
        },
        {
          "name": "2. Esperar sincronizacion eventos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "setTimeout(function () {}, 2000);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categorias"
          }
        },
        {
          "name": "3. Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login correcto', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.environment.set('token', body.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "4. Alta producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Producto creado', function () { pm.response.to.have.status(201); });",
                  "const location = pm.response.headers.get('Location');",
                  "if (location) {",
                  "    const parts = location.split('/');",
                  "    pm.environment.set('productId', parts[parts.length - 1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Portatil de prueba\",\n  \"descripcion\": \"Portatil para pruebas\",\n  \"precio\": 499.99,\n  \"estado\": \"NUEVO\",\n  \"idCategoria\": \"{{categoryId}}\",\n  \"envioDisponible\": true,\n  \"idVendedor\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/productos"
          }
        },
        {
          "name": "5. Registrar compraventa",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idProducto\": \"{{productId}}\",\n  \"idComprador\": \"{{userId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/compraventas"
          }
        }
      ]
    }
  ]
}
